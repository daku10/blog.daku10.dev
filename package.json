{
  "name": "blog.daku10.dev",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "build:preview": "astro build && printf '/*\\n  X-Robots-Tag: noindex, nofollow\\n' > out/_headers",
    "build:production": "astro build",
    "start": "serve out",
    "deploy": "pnpm wrangler deploy",
    "deploy:preview": "pnpm wrangler deploy --env=preview",
    "preview:workers": "wrangler dev",
    "lint": "concurrently 'pnpm:lint:*'",
    "lint:ts": "astro check",
    "lint:es": "oxlint --type-aware src astro.config.mjs tailwind.config.ts",
    "lint:markup": "markuplint './src/**/*.{j,t}sx'",
    "lint:text": "textlint src/content/posts/**/index.md",
    "lint:format": "oxfmt --check .",
    "analyze": "astro build",
    "format": "oxfmt --write ."
  },
  "dependencies": {
    "@astrojs/preact": "5.1.5",
    "@preact/signals": "2.11.1",
    "@tabler/icons-preact": "3.46.0",
    "astro": "6.1.10",
    "clsx": "2.1.1",
    "preact": "10.29.8",
    "rehype-autolink-headings": "7.1.0",
    "rehype-external-links": "3.0.0",
    "rehype-pretty-code": "0.14.5",
    "rehype-slug": "6.0.0",
    "remark-gfm": "4.0.1",
    "rss": "1.2.2",
    "satori": "0.33.4",
    "sharp": "0.34.5",
    "shiki": "4.4.3",
    "simple-icons": "16.29.0",
    "tailwind-merge": "3.6.0",
    "valibot": "1.3.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@markuplint/jsx-parser": "4.7.23",
    "@markuplint/ml-core": "4.13.3",
    "@markuplint/react-spec": "4.5.23",
    "@tailwindcss/typography": "0.5.20",
    "@tailwindcss/vite": "4.3.3",
    "@types/hast": "3.0.5",
    "@types/node": "24.13.3",
    "@types/rss": "0.0.32",
    "budoux": "0.9.1",
    "concurrently": "9.2.4",
    "markuplint": "4.14.1",
    "oxfmt": "0.46.0",
    "oxlint": "1.61.0",
    "oxlint-tsgolint": "0.25.0",
    "serve": "14.2.6",
    "tailwindcss": "4.3.3",
    "textlint": "15.8.0",
    "textlint-rule-preset-ja-spacing": "2.4.3",
    "textlint-rule-preset-ja-technical-writing": "12.0.2",
    "textlint-rule-spellcheck-tech-word": "5.0.0",
    "typescript": "6.0.3",
    "wrangler": "4.127.1"
  },
  "packageManager": "pnpm@10.34.5",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@tailwindcss/oxide",
      "es5-ext",
      "sharp"
    ],
    "patchedDependencies": {}
  }
}
